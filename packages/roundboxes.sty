\ProvidesPackage{roundboxes}

\usepackage{colors}
\RequirePackage{tcolorbox}
\tcbuselibrary{theorems, breakable} 

\tcbset{
    myboxstyle/.style={
        fonttitle=\bfseries,
        parbox=false,
        breakable,
        colback=#1!5!white,
        colframe=#1,
        colbacktitle=#1
    }
}

\newtcbtheorem{defbox}{Def.}{myboxstyle=ColorDef}{def}
\newtcbtheorem{lemmabox}{Lemma}{myboxstyle=ColorLemma}{lem}
\newtcbtheorem{thmbox}{Thm.}{myboxstyle=ColorThm}{thm}

\newtcolorbox{proofbox}[1][]{
    myboxstyle=ColorProof,
    title=Proof,
    #1
}

\newtcolorbox{gbox}[2][]{
    myboxstyle=ColorGen,
    title={#2}, 
    #1 
}
