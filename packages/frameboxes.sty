\ProvidesPackage{frameboxes}

\usepackage{colors}
\RequirePackage{tcolorbox}
\tcbuselibrary{theorems, breakable, skins, hooks}
\RequirePackage{xparse}
\tcbset{
  % argument: primary color
  baseboxstyle/.style={
    enhanced,
    breakable,
    parbox=false,
    colback=#1!5!white, % 5% of the primary color with 95% white
    frame hidden,
    boxrule=0pt,
    borderline west={2pt}{0pt}{#1}, % left border uses primary color
    sharp corners,
    detach title,
    before upper=\tcbtitle\par\smallskip,
    coltitle=#1, % title uses primary color
    fonttitle={\sffamily\large},
    segmentation style={solid, #1},
    separator sign none,
  },
  claimstyle/.style={
    baseboxstyle={#1},
    description font=\bfseries,
  }
}

\newcounter{globaldefcounter} 
\newcounter{thmcounter} 

\newtcbtheorem[use counter=globaldefcounter]{defframe}{Def.}
  {claimstyle={ColorDef}}{def}

\newtcbtheorem{lemmaframe}{Lemma}
  {claimstyle={ColorLemma}}{lemma}

\newtcbtheorem[use counter=thmcounter]{thmframe}{Thm.}
  {claimstyle={ColorThm}}{thm}

\NewDocumentEnvironment{corframe}{m} 
{%
  \begin{tcolorbox}[
    baseboxstyle={ColorCor}, 
    title={Corollary for Thm.~\thethmcounter: \textbf{#1}}, 
    fonttitle={\bfseries\sffamily\large}
  ]%
}%
{%
  \end{tcolorbox}%
}

\newtcbtheorem{propframe}{Prop.}
  {claimstyle={ColorThm}}{prop}

% ENVIRONMENTS

\newtcolorbox{proofframe}[1][]{
  baseboxstyle={ColorProof}, 
  title=Proof,
  #1
}

% proof without title
\newtcolorbox{pframe}[1][]{
  baseboxstyle={ColorProof}, 
  notitle,
  #1
}

% generic frame
\newtcolorbox{gframe}[2][]{
  baseboxstyle={ColorGen}, 
  description font=\mdseries, 
  title=#2,
  #1
}

% syntax is : \begin{cdefframe}{<ColorName>}{<title>}
\NewDocumentEnvironment{cdefframe}{mm} 
{%
  \refstepcounter{globaldefcounter}
  \begin{tcolorbox}[baseboxstyle={#1}, title={Def.~\theglobaldefcounter: \textbf{#2}}]
}%
{%
  \end{tcolorbox}
}

% syntax is : \begin{cframe}{<ColorName>}{<title>}
\NewDocumentEnvironment{cframe}{mm}
{%
  \begin{tcolorbox}[
    baseboxstyle={#1},
    title={#2},
    fonttitle={\bfseries\sffamily\large}
  ]
}%
{%
  \end{tcolorbox}
}

% shaded
\newtcolorbox{shaded}{
    frame hidden,
    boxrule=0pt,
    colback=ColorGen!15!white,
    sharp corners,
    breakable,
    parbox=false,
    left=1em,
    right=1em
}

% usage: \shade{some text} (inline)
\newtcbox{\shade}{
    on line,
    frame hidden,
    boxrule=0pt,
    colback=ColorGen!15!white,
    sharp corners,
    boxsep=0pt,
    left=2pt, 
    right=2pt, 
    top=2pt, 
    bottom=2pt
}
