% super simple same-page title
\newcommand{\makeinpagetitle}[3]{
    \begin{flushleft}
        \vspace*{1cm}
        {\color{ColorLemma}\rule{\linewidth}{2pt}}\\[0.6cm] % top accent line
        {\Huge\bfseries\sffamily #1}\\[0.4cm]             % title
        {\Large\sffamily #2}\\[0.2cm]                     % author
        {\large\sffamily\color{gray} #3}\\[0.4cm]         % date or subtitle
        {\color{ColorLemma}\rule{\linewidth}{1pt}}          % bottom accent line
    \end{flushleft}
}

\newcommand{\makefullpagetitle}[4]{
    \begin{titlepage}
        \begin{flushleft}
            \vspace*{0.2\textheight} 
            
            {\fontsize{38}{45}\selectfont\bfseries\sffamily #1}\\[0.6cm]             
            
            {\LARGE\sffamily #2}\\[0.5cm]                     
            
            {\rule{0.5\linewidth}{2pt}}\\[0.7cm] 
            
            {\Large\sffamily #3}\\[0.4cm]                     
            
            {\large\sffamily\color{darkgray} #4}                  
            
            \vfill 
        \end{flushleft}
    \end{titlepage}
}
