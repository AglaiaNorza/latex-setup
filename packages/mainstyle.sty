\ProvidesPackage{mainstyle}

% ===================================
% font settings
% ===================================
\RequirePackage{fontspec}
\setsansfont{IBM Plex Sans}
% for a less modern vibe:
%\setmainfont{IBM Plex Serif}
\setmainfont{IBM Plex Sans}

\RequirePackage{unicode-math}
\setmathfont{STIXTwoMath-Regular.otf}

% ===================================
% page layout
% ===================================
\usepackage{geometry}

\geometry{a4paper, left=2cm, right=2cm, top=2.5cm, bottom=2.5cm}

\setlength{\parskip}{6pt}
\setlength{\parindent}{0pt}

\DeclareMathSizes{11}{13}{9}{9}

% ===================================
% lists
% ===================================
\usepackage{enumitem}

\setlist[itemize]{topsep=0pt, itemsep=3pt}
\setlist[enumerate]{topsep=0pt, itemsep=3pt}

% circle:
%\setenumerate{label=(\arabic*)}
% square:
%\setenumerate{label=\fbox{\arabic*}}
\setenumerate{label=\textcolor{chaptergray}{\sffamily\arabic* |}}
\def\labelitemi{\scalebox{0.5}{$\blacksquare$}}

% ===================================
% sections
% ===================================
\usepackage{titlesec}
\usepackage{xcolor}

\definecolor{chaptergray}{gray}{0.6}

\@ifundefined{chapter}{}{
  \titleformat{\chapter}[display]
    {\normalfont\sffamily\raggedleft}
    {\textcolor{chaptergray}{\Large\bfseries CHAPTER \thechapter}}
    {5pt}
    {\Huge\bfseries}[\vspace{1ex}\color{chaptergray}\titlerule]
    
  \titlespacing*{\chapter}{0pt}{10pt}{40pt}
}

\setcounter{secnumdepth}{3}

\titleformat{\section}
  {\normalfont\Large\bfseries\sffamily}
  {\textcolor{chaptergray}{\thesection \hspace{6pt} \rule[-2pt]{1.5pt}{14pt} \hspace{6pt}}}
  {0pt}
  {}

\titlespacing*{\section}{0pt}{14pt}{6pt}

\titleformat{\subsection}
  {\normalfont\large\bfseries\sffamily}
  {\textcolor{chaptergray}{\thesubsection \hspace{4pt} \rule[-1.5pt]{1.2pt}{11pt} \hspace{4pt}}}
  {0pt}
  {}

\titlespacing*{\subsection}{0pt}{10pt}{4pt}

\titleformat{\subsubsection}
  {\normalfont\normalsize\bfseries\sffamily}
  {\textcolor{chaptergray}{\thesubsubsection}}
  {0.75em}
  {}

\titlespacing*{\subsubsection}{0pt}{10pt}{4pt}

\titleformat{name=\section,numberless}
  {\normalfont\Large\bfseries\sffamily}
  {\textcolor{chaptergray}{\rule[-2pt]{1.5pt}{14pt} \hspace{6pt}}}
  {0pt}
  {}

\titleformat{name=\subsection,numberless}
  {\normalfont\large\bfseries\sffamily}
  {\textcolor{chaptergray}{\rule[-1.5pt]{1.2pt}{11pt} \hspace{4pt}}}
  {0pt}
  {}

\titleformat{name=\subsubsection,numberless}
  {\normalfont\normalsize\bfseries\sffamily}
  {}
  {0pt}
  {}

% ===================================
% table of contents
% ===================================
\usepackage{tocloft}

\renewcommand{\cfttoctitlefont}{\normalfont\Huge\bfseries\sffamily}
\renewcommand{\cftsecfont}{\sffamily}
\renewcommand{\cftsecpagefont}{\sffamily}

\@ifundefined{chapter}{}{
  \renewcommand{\cftchapfont}{\sffamily\bfseries}
  \renewcommand{\cftchappagefont}{\sffamily\bfseries}
}

% ===================================
% header / footer 
% ===================================
\RequirePackage{fancyhdr}

\pagestyle{fancy}
\fancyhf{}

\fancyhead[R]{\sffamily\nouppercase{\rightmark}} % right header: section name

\fancyfoot[L]{\sffamily\nouppercase{\leftmark}} % left footer: chapter name
\fancyfoot[R]{\sffamily\thepage} % right footer: page number

\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0.4pt}

\@ifundefined{chapter}{}{
  \renewcommand{\chaptermark}[1]{%
    \markboth{\thechapter\quad #1}{}%
  }
}

\renewcommand{\sectionmark}[1]{%
  \markright{\thesection\quad #1}%
}
