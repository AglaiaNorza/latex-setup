\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{title}

\RequirePackage{graphicx}
\RequirePackage{fontawesome5}
\RequirePackage{tikz}
\RequirePackage{xcolor}

\def\@universityname{TU Wien}
\def\@coursename{Course Title}
\def\@coursebook{Course Material}
\def\@authorname{Author Name}
\def\@authoremail{email@example.com}
\def\@authorgithub{username}
\def\@coverphoto{}

\def\@coverwidth{0.65\textwidth}
\def\@coverheight{0.35\textwidth}
\def\@beforespace{3cm}
\def\@afterspace{3cm}

\newcommand{\setuniversity}[1]{\def\@universityname{#1}}
\newcommand{\setcoursename}[1]{\def\@coursename{#1}}
\newcommand{\setcoursebook}[1]{\def\@coursebook{#1}}
\newcommand{\setauthorname}[1]{\def\@authorname{#1}}
\newcommand{\setauthoremail}[1]{\def\@authoremail{#1}}
\newcommand{\setauthorgithub}[1]{\def\@authorgithub{#1}}
\newcommand{\setcoverphoto}[1]{\def\@coverphoto{#1}}

\newcommand{\setcoverwidth}[1]{\def\@coverwidth{#1}}
\newcommand{\setcoverheight}[1]{\def\@coverheight{#1}}
\newcommand{\setbeforespace}[1]{\def\@beforespace{#1}}
\newcommand{\setafterspace}[1]{\def\@afterspace{#1}}

\newcommand{\makecustomcover}{
    \begin{titlepage}
        \sffamily
        \raggedleft
        \vspace*{4cm}

        {\Large\textcolor{chaptergray}{\scshape\bfseries \@universityname} \par}
        \vspace{-0.5em}

        {\fontsize{40}{48}\selectfont\bfseries \@coursename \par}
        \vspace{1ex}
        
        {\color{chaptergray}\rule{\textwidth}{1.5pt} \par}
        \vspace{2ex}

        {\Large\textcolor{chaptergray}{\itshape course material: \@coursebook} \par}
        
        \vspace{\@beforespace}

        \ifx\@coverphoto\empty
            \textcolor{chaptergray}{\rule{\@coverwidth}{\@coverheight}} \par
        \else
            \begin{tikzpicture}
                \useasboundingbox (0,0) rectangle (\@coverwidth, \@coverheight);
                \clip (0,0) rectangle (\@coverwidth, \@coverheight);
                
                \node[anchor=center, inner sep=0pt] at (current bounding box.center) {
                    \includegraphics[width=\@coverwidth]{\@coverphoto}
                };
            \end{tikzpicture} \par
        \fi
        
        \vspace{\@afterspace}

        {\Large\bfseries \@authorname \par}
        \vspace{0.25cm}
        {\large\textcolor{chaptergray}{\today} \par}

        \vfill

        {\small\textcolor{chaptergray}{
            \href{mailto:\@authoremail}{\faEnvelope\ \@authoremail} \\
            \vspace{0.15cm}
            \href{https://github.com/\@authorgithub}{\faGithub\ github.com/\@authorgithub}
        }}
        
        \vspace*{-1cm}
    \end{titlepage}
}
