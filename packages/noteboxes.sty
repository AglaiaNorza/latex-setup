% based on https://xyquadrat.ch/blog/latex-boxes/
\ProvidesPackage{noteboxes}

\usepackage{colors}
\RequirePackage{tcolorbox}
\tcbuselibrary{theorems, breakable}

\tcbset{
  modernbase/.style={
    arc=0mm,
    bottomtitle=0.5mm,
    boxrule=0mm,
    coltitle=white,
    fonttitle=\bfseries,
    left=2.5mm,
    right=3.5mm,
    toptitle=0.75mm,
    breakable,
    parbox=false,
    leftrule=1.7mm,
    colframe=#1,
    colback=#1!5!white,
    colbacktitle=#1
  }
}

\newtcbtheorem{defnote}{Def.}{modernbase=ColorDef}{def}
\newtcbtheorem{lemmanote}{Lemma}{modernbase=ColorLemma}{lem}
\newtcbtheorem{thmnnote}{Thm.}{modernbase=ColorThm}{thm}
\newtcbtheorem{propnote}{Prop.}{modernbase=ColorThm}{prop}

\newtcolorbox{proofnote}[1][]{
  modernbase=ColorProof,
  title={Proof!},
  #1
}

\newtcolorbox{gnote}[2][]{
  modernbase=ColorGen,
  title={#2},
  #1
}

\newtcolorbox{pnote}[1][]{
  modernbase=ColorProof,
  notitle,
  #1
}
